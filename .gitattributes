* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.png binary
*.pdf binary
# These files carry byte-level source/evidence hashes; preserve their bytes.
samples/** -text -whitespace
evaluations/** -text whitespace=cr-at-eol
models/manifest.json -text whitespace=cr-at-eol
aigc_detector/profiles/*.json -text whitespace=cr-at-eol
aigc_detector/resource_manifest.json -text whitespace=cr-at-eol
